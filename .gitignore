
# ==========================================
# Python cache and virtual environments
# ==========================================
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
.venv/
venv/
env/

# ==========================================
# Secrets and environment variables
# ==========================================
.env
.env.*
!.env.example

# ==========================================
# Raw and external datasets
# ==========================================
data/raw/*
!data/raw/.gitkeep
data/external/

# Processed datasets: ignore generated data
data/processed/*
!data/processed/.gitkeep

# ==========================================
# Trained models
# ==========================================
# Ignore model files by default; selected checkpoints
# can be force-added only after checking their size.
models/*
!models/.gitkeep
*.pt
*.keras
*.h5
*.weights.h5

# ==========================================
# Generated output and training runs
# ==========================================
outputs/predictions/
outputs/edgevision_label_preview/
outputs/hard_examples_contact_sheet.jpg
outputs/figures/*
!outputs/figures/.gitkeep
outputs/metrics/*
!outputs/metrics/.gitkeep
outputs/training_history/*
!outputs/training_history/.gitkeep
outputs/yolo_training/
runs/

# ==========================================
# Generated videos
# ==========================================
*.mp4
*.avi
*.mov
*.mkv

# ==========================================
# IDE and operating system files
# ==========================================
.vscode/
.DS_Store
Thumbs.db
